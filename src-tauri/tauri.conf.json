{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termix",
  "version": "0.1.0",
  "identifier": "dev.ravn.termix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Termix",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
